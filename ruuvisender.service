[Unit]
Description=Ruuvi sender service
Wants=network-online.target bluetooth.target
After=network-online.target bluetooth.target

[Service]
Type=simple
ExecStart=/home/pi/RuuviSender/venv/bin/python /home/pi/RuuviSender/RuuviSender.py
WorkingDirectory=/home/pi/RuuviSender
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
